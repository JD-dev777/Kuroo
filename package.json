{
  "name": "kuroo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kuroo Discord security and moderation bot",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "mongoose": "^9.11.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
